#!/bin/sh

echo "🔍 Running Spotless check..."
if [ -f "./mvnw" ]; then
  MVN="./mvnw"
else
  MVN="mvn"
fi

$MVN -q spotless:check
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Formatting check failed!"
  echo "Your code is not formatted correctly."
  echo "👉 Run: mvn spotless:apply"
  echo ""
  exit 1
fi
echo "✅ Spotless OK!"

echo ""
echo "🧪 Running tests..."
$MVN -q test
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed!"
  echo "Fix failing tests before pushing."
  echo ""
  exit 1
fi
echo "✅ Tests passed!"

echo ""
echo "🔨 Running full Maven build (verify)..."
$MVN -q clean verify
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Build failed!"
  echo "Fix the errors above and try again."
  exit 1
fi

echo "🎉 All checks passed — pushing allowed!"
exit 0